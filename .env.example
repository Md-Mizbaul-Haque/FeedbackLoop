# Supabase — get these from your project at https://supabase.com/dashboard
# Settings > API (publishable/anon key) and Settings > API keys (secret key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key
# Optional: Supabase auth base URL used for email verification links.
# Defaults to NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_AUTH_URL=https://your-project-ref.supabase.co
# Public URL of the deployed app — used for Lemon Squeezy post-purchase redirects
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Send email hook (supabase → /api/send-email → SMTP)
# Generate with: openssl rand -base64 32 (prefix with "v1,whsec_")
SEND_EMAIL_HOOK_SECRET=v1,whsec_your-secret

# Lemon Squeezy (payments) — get these from your store settings:
# https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=your-api-key
LEMONSQUEEZY_STORE_ID=your-store-id
# Signing secret from the webhook you create in the dashboard:
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret
# The numeric variant ID of your Pro subscription:
# https://app.lemonsqueezy.com/products → Pro → Variants
LEMONSQUEEZY_PRO_VARIANT_ID=your-variant-id
# Optional: numeric variant ID of the yearly Pro subscription (billing toggle on /pricing)
LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID=your-yearly-variant-id
# Webhook URL to register: https://<your-app>/api/lemon-squeezy/webhook
# Subscribe to: order_created, subscription_created, subscription_updated,
#               subscription_payment_success, subscription_payment_failed,
#               subscription_resumed, subscription_unpaused,
#               subscription_cancelled, subscription_expired, subscription_paused,
#               subscription_payment_refunded, order_refunded
# Optional: accept Lemon Squeezy test-mode webhooks (local/test environments only)
# LEMONSQUEEZY_ALLOW_TEST_MODE=true

# SMTP / transactional email — used for OTP signup emails and the auth webhook.
# The visible sender is EMAIL_FROM (the address users see). SMTP_USER is only
# the account that authenticates with the SMTP server — they can differ.
#
# If you use Gmail SMTP, the From address must be the Gmail address itself or
# a "Send mail as" identity verified in that Gmail account; otherwise Gmail
# rewrites it and shows "via <gmail-address>". For a custom domain sender
# (no-reply@yourdomain.com) use a transactional provider (Resend, SendGrid,
# Amazon SES, Mailgun) and verify the domain (SPF/DKIM) with that provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-smtp-auth-account@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# SMTP_PASS is accepted as a legacy alias of SMTP_PASSWORD.
# SMTP_FROM is deprecated; use EMAIL_FROM instead.

EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=FeedbackLoop
# Optional — only set if you have a real support inbox:
# EMAIL_REPLY_TO=support@yourdomain.com